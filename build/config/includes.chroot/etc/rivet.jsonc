
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/fastfetch/rivet.fastfetch.txt",
    "color": {
      "1": "#1E4FD8",
      "2": "#00A8E8",
      "3": "#10C7A0",
      "4": "#7BE04A"
    },
    "padding": {
      "top": 0,
      "left": 1,
      "right": 3
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "cpu",
    "memory"
  ]
}
