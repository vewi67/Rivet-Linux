#!/usr/bin/python3
"""First-login welcome window for Rivet Linux."""

import glob
import os
import random
import shutil
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GdkPixbuf

CHIP_DIR = "/usr/share/rivet/chip"
MARKER = os.path.expanduser("~/.config/rivet/welcome-seen")
INSTALLER = "/usr/bin/rivet-installer"


class RivetWelcome(Gtk.Window):
    def __init__(self):
        super().__init__(title="Welcome to Rivet Linux")
        self.set_default_size(680, 480)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(24)
        self.set_icon_name("rivet")
        self.connect("delete-event", self.on_close)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        outer.set_halign(Gtk.Align.CENTER)
        outer.set_valign(Gtk.Align.CENTER)
        self.add(outer)

        images = sorted(glob.glob(os.path.join(CHIP_DIR, "*.png")))
        if images:
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    random.choice(images), 144, 144, True
                )
                mascot = Gtk.Image.new_from_pixbuf(pixbuf)
                mascot.set_halign(Gtk.Align.CENTER)
                mascot.set_tooltip_text("Chip, the Rivet Linux beaver")
                outer.pack_start(mascot, False, False, 0)
            except (OSError, ValueError) as error:
                print(f"Rivet could not load the Chip image: {error}", file=sys.stderr)

        title = Gtk.Label()
        title.set_markup(
            '<span size="xx-large" weight="bold">Welcome to Rivet Linux</span>'
        )
        title.set_halign(Gtk.Align.CENTER)
        outer.pack_start(title, False, False, 0)

        tagline = Gtk.Label()
        tagline.set_markup('<span size="large">Your computer. Your rules.</span>')
        tagline.set_halign(Gtk.Align.CENTER)
        outer.pack_start(tagline, False, False, 0)

        description = Gtk.Label(
            label=(
                "A lightweight system built to be explored, used, and changed. "
                "Set the mood with Rivet Atmosphere, which can gently rotate our wallpapers."
            )
        )
        description.set_line_wrap(True)
        description.set_max_width_chars(62)
        description.set_justify(Gtk.Justification.CENTER)
        description.set_halign(Gtk.Align.CENTER)
        outer.pack_start(description, False, False, 2)

        self.status = Gtk.Label()
        self.status.set_line_wrap(True)
        self.status.set_max_width_chars(72)
        self.status.set_halign(Gtk.Align.CENTER)
        outer.pack_start(self.status, False, False, 0)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        buttons.set_halign(Gtk.Align.CENTER)
        outer.pack_start(buttons, False, False, 8)

        install_button = Gtk.Button(label="Install Rivet")
        install_button.get_style_context().add_class("suggested-action")
        install_button.connect("clicked", self.launch_installer)
        buttons.pack_start(install_button, False, False, 0)

        files_button = Gtk.Button(label="Open files")
        files_button.connect(
            "clicked", self.launch_app, ["thunar", os.path.expanduser("~")]
        )
        buttons.pack_start(files_button, False, False, 0)

        settings_button = Gtk.Button(label="Settings")
        settings_button.connect(
            "clicked", self.launch_app, ["xfce4-settings-manager"]
        )
        buttons.pack_start(settings_button, False, False, 0)

        atmosphere_button = Gtk.Button(label="Atmosphere")
        atmosphere_button.connect(
            "clicked", self.launch_app, ["rivet-atmosphere"]
        )
        buttons.pack_start(atmosphere_button, False, False, 0)

        chip_fixs_button = Gtk.Button(label="Chip Fixs")
        chip_fixs_button.get_style_context().add_class("suggested-action")
        chip_fixs_button.connect(
            "clicked", self.launch_app, ["chip-fixs"]
        )
        buttons.pack_start(chip_fixs_button, False, False, 0)

        done_button = Gtk.Button(label="Let's go")
        done_button.connect("clicked", self.on_done)
        buttons.pack_start(done_button, False, False, 0)

    def launch_app(self, _button, command):
        if shutil.which(command[0]) is None:
            self.status.set_text(f"Could not find {command[0]} on this system.")
            return
        try:
            subprocess.Popen(command, close_fds=True, start_new_session=True)
            self.status.set_text(f"Opening {command[0]}...")
        except OSError as error:
            self.status.set_text(f"Could not open the application: {error}")

    def launch_installer(self, _button):
        if not os.path.isfile(INSTALLER) or not os.access(INSTALLER, os.X_OK):
            self.status.set_text(
                "The installer is missing. Please restart the live session or "
                "report this build as broken."
            )
            return
        try:
            subprocess.Popen(
                [INSTALLER], close_fds=True, start_new_session=True
            )
            self.status.set_text(
                "Starting the installer. If an authorization prompt appears, "
                "complete it to continue."
            )
        except OSError as error:
            self.status.set_text(f"Could not start the installer: {error}")

    @staticmethod
    def mark_seen():
        os.makedirs(os.path.dirname(MARKER), exist_ok=True)
        with open(MARKER, "w", encoding="utf-8") as marker:
            marker.write("shown\n")

    def on_done(self, *_):
        self.mark_seen()
        self.destroy()
        Gtk.main_quit()

    def on_close(self, *_):
        self.mark_seen()
        Gtk.main_quit()
        return True


if __name__ == "__main__":
    if os.path.exists(MARKER) and "--show-again" not in sys.argv:
        sys.exit(0)
    try:
        RivetWelcome().show_all()
        Gtk.main()
    except Exception as error:
        print(f"Rivet welcome could not start: {error}", file=sys.stderr)
        sys.exit(1)
