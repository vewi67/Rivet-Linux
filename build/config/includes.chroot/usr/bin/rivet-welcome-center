#!/usr/bin/python3
"""Installed-system welcome center and settings hub for Rivet Linux."""

from __future__ import annotations

import os
from pathlib import Path
import random
import shutil
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GdkPixbuf, Gtk

APP_NAME = "Welcome to Rivet"
CHIP_DIR = Path("/usr/share/rivet/chip")
MARKER = Path.home() / ".config/rivet/welcome-seen"
CSS = b"""
window#rivet-welcome-center { background-color: @theme_bg_color; }
headerbar#rivet-welcome-header { padding: 5px 10px; }
.rivet-sidebar { padding: 18px 10px; }
.rivet-brand { font-size: 19px; font-weight: bold; }
.rivet-muted { color: @theme_unfocused_fg_color; }
.rivet-page-title { font-size: 25px; font-weight: bold; }
.rivet-section-title { font-size: 17px; font-weight: bold; }
.rivet-hero {
  background-image: linear-gradient(130deg, #163f60, #167e75);
  border-radius: 18px;
  padding: 22px;
}
.rivet-hero label { color: #ffffff; }
.rivet-hero-title { font-size: 29px; font-weight: bold; }
.rivet-hero-subtitle { font-size: 15px; }
.rivet-card {
  padding: 13px;
  border-radius: 13px;
  border: 1px solid alpha(@theme_fg_color, 0.12);
}
.rivet-card:hover { border-color: #2b9d95; }
.rivet-card-title { font-weight: bold; font-size: 14px; }
.rivet-card-description { color: @theme_unfocused_fg_color; font-size: 12px; }
.rivet-status { padding: 7px 14px; color: @theme_unfocused_fg_color; }
.rivet-primary { padding: 9px 16px; font-weight: bold; }
