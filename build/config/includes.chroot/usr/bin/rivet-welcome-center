QUICK_TOOLS = (
    ("Rivet Atmosphere", "Wallpaper styles and ambient rotation",
     "preferences-desktop-wallpaper", ("rivet-atmosphere",)),
    ("Chip Fixs", "Hardware information and diagnostics",
     "applications-system", ("chip-fixs",)),
    ("Software Store", "Discover and install desktop applications",
     "system-software-install", ("gnome-software",)),
    ("Disks & Partitions", "Inspect storage and partition layouts",
     "drive-harddisk", ("gparted",)),
    ("File Manager", "Browse files and folders",
     "system-file-manager", ("thunar",)),
    ("Terminal", "Open a command-line session",
     "utilities-terminal", ("xfce4-terminal",)),
)


def is_live_session(
    cmdline_path="/proc/cmdline",
    run_live_medium="/run/live/medium",
    lib_live_medium="/lib/live/mount/medium",
    mount_check=None,
):
    """Return True for live boot flags or active live-medium mounts."""
    if mount_check is None:
        mount_check = os.path.ismount
    try:
        cmdline = Path(cmdline_path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        cmdline = ""
    if "boot=live" in cmdline.split():
        return True
    # Directory existence alone can be a leftover from a previous installation.
    return mount_check(run_live_medium) or mount_check(lib_live_medium)


def mark_welcome_seen():
    """Persist dismissal for this user without changing any system configuration."""
    MARKER.parent.mkdir(parents=True, exist_ok=True)
    temporary = MARKER.with_suffix(".tmp")
    temporary.write_text("shown\n", encoding="utf-8")
    temporary.replace(MARKER)


def load_os_summary():
    """Read a small, local-only summary from os-release."""
    values = {}
    try:
        lines = Path("/etc/os-release").read_text(encoding="utf-8").splitlines()
    except OSError:
        return "Linux desktop • XFCE"

    for line in lines:
        key, separator, value = line.partition("=")
        if separator and key in {"PRETTY_NAME", "VERSION_CODENAME"}:
            values[key] = value.strip().strip('"')
    base = values.get("PRETTY_NAME", "Linux desktop")
    codename = values.get("VERSION_CODENAME")
    if codename and codename.lower() not in base.lower():
        return f"{base} • {codename} • XFCE"
    return f"{base} • XFCE"


class RivetWelcomeCenter:
    def __init__(self):
        self.window = Gtk.Window(title=APP_NAME)
        self.window.set_name("rivet-welcome-center")
        self.window.set_default_size(1120, 760)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.set_icon_name("rivet")
        self.window.connect("delete-event", self.on_close)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        header = Gtk.HeaderBar()
        header.set_name("rivet-welcome-header")
        header.set_title(APP_NAME)
        header.set_subtitle("Your computer. Your rules.")
        header.set_show_close_button(True)
        self.window.set_titlebar(header)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.window.add(root)

        main = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        root.pack_start(main, True, True, 0)

        sidebar_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        sidebar_box.set_size_request(205, -1)
        sidebar_box.get_style_context().add_class("rivet-sidebar")
        main.pack_start(sidebar_box, False, False, 0)

        brand = Gtk.Label(label="RIVET")
        brand.set_xalign(0)
        brand.get_style_context().add_class("rivet-brand")
        sidebar_box.pack_start(brand, False, False, 5)

        brand_hint = Gtk.Label(label="Welcome and settings")
        brand_hint.set_xalign(0)
        brand_hint.get_style_context().add_class("rivet-muted")
        sidebar_box.pack_start(brand_hint, False, False, 0)
        sidebar_box.pack_start(Gtk.Separator(), False, False, 8)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(120)
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)

        self.stack.add_titled(self.build_home_page(), "home", "Welcome")
        self.stack.add_titled(self.build_settings_page(), "settings", "System settings")
        self.stack.add_titled(self.build_tools_page(), "tools", "Rivet tools")
        self.stack.add_titled(self.build_about_page(), "about", "About Rivet")

        sidebar = Gtk.StackSidebar()
        sidebar.set_stack(self.stack)
        sidebar_box.pack_start(sidebar, True, True, 0)
        main.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)
        main.pack_start(self.stack, True, True, 0)

        self.status = Gtk.Label(label="Settings open their native desktop tools. No changes are made automatically.")
        self.status.set_xalign(0)
        self.status.get_style_context().add_class("rivet-status")
        root.pack_end(self.status, False, False, 0)
        root.pack_end(Gtk.Separator(), False, False, 0)

    def new_scrolled_page(self):
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        content.set_border_width(24)
        scroll.add(content)
        return scroll, content

    def chip_image(self, size=150):
        images = sorted(CHIP_DIR.glob("*.png"))
        for image in ([random.choice(images)] if images else []):
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    str(image), size, size, True
                )
                mascot = Gtk.Image.new_from_pixbuf(pixbuf)
                mascot.set_tooltip_text("Chip, the Rivet Linux beaver")
                return mascot
            except (OSError, ValueError) as error:
                print(f"Welcome center could not load {image}: {error}", file=sys.stderr)
        fallback = Gtk.Image.new_from_icon_name("face-smile", Gtk.IconSize.DIALOG)
        fallback.set_pixel_size(size)
        return fallback

    def page_heading(self, parent, title, description):
        heading = Gtk.Label(label=title)
        heading.set_xalign(0)
        heading.get_style_context().add_class("rivet-page-title")
        parent.pack_start(heading, False, False, 0)

        detail = Gtk.Label(label=description)
        detail.set_xalign(0)
        detail.set_line_wrap(True)
        detail.get_style_context().add_class("rivet-muted")
        parent.pack_start(detail, False, False, 0)

    def make_card(self, title, description, icon_name, command, category=None):
        button = Gtk.Button()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_hexpand(True)
        button.get_style_context().add_class("rivet-card")
        button.connect("clicked", self.launch_command, command, title)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.set_halign(Gtk.Align.START)
        image = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.DIALOG)
        image.set_pixel_size(30)
        image.set_valign(Gtk.Align.START)
        row.pack_start(image, False, False, 0)

        details = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        details.set_hexpand(True)
        name = Gtk.Label(label=title)
        name.set_xalign(0)
        name.set_line_wrap(True)
        name.get_style_context().add_class("rivet-card-title")
        details.pack_start(name, False, False, 0)

        if category:
            category_label = Gtk.Label(label=category.upper())
            category_label.set_xalign(0)
            category_label.get_style_context().add_class("rivet-muted")
            details.pack_start(category_label, False, False, 0)

        detail = Gtk.Label(label=description)
        detail.set_xalign(0)
        detail.set_line_wrap(True)
        detail.set_max_width_chars(34)
        detail.get_style_context().add_class("rivet-card-description")
        details.pack_start(detail, False, False, 0)
        row.pack_start(details, True, True, 0)
        button.add(row)
        return button

    def build_home_page(self):
        scroll, content = self.new_scrolled_page()

        hero = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=22)
        hero.get_style_context().add_class("rivet-hero")
        hero.pack_start(self.chip_image(158), False, False, 0)

        hero_text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        hero_text.set_valign(Gtk.Align.CENTER)
        title = Gtk.Label(label=APP_NAME)
        title.set_xalign(0)
        title.get_style_context().add_class("rivet-hero-title")
        hero_text.pack_start(title, False, False, 0)

        slogan = Gtk.Label(label="Your computer. Your rules.")
        slogan.set_xalign(0)
        slogan.get_style_context().add_class("rivet-hero-subtitle")
        hero_text.pack_start(slogan, False, False, 0)

        intro = Gtk.Label(
            label="Make Rivet feel like yours. Explore the desktop, tune your devices, "
                  "and find the tools you need, all from one place."
        )
        intro.set_xalign(0)
        intro.set_line_wrap(True)
        intro.set_max_width_chars(68)
        hero_text.pack_start(intro, False, False, 0)

        primary = Gtk.Button(label="Open system settings")
        primary.get_style_context().add_class("suggested-action")
        primary.get_style_context().add_class("rivet-primary")
        primary.connect("clicked", self.select_page, "settings")
        hero_text.pack_start(primary, False, False, 6)
        hero.pack_start(hero_text, True, True, 0)
        content.pack_start(hero, False, False, 0)

        self.page_heading(
            content,
            "A good place to start",
            "The common things are one click away. Nothing is changed until you choose an action.",
        )
        quick = Gtk.Grid()
        quick.set_column_spacing(12)
        quick.set_row_spacing(12)
        quick.set_column_homogeneous(True)
        home_cards = (
            ("System settings", "Themes, display, input, sound, network and more.",
             "preferences-system", "settings"),
            ("Rivet tools", "Atmosphere, Chip Fixs and everyday utilities.",
             "applications-system", "tools"),
            ("Personalize the desktop", "Choose your style, wallpaper and layout.",
             "preferences-desktop-theme", "settings"),
            ("Learn about Rivet", "See what Rivet is built on and where its tools live.",
             "help-about", "about"),
        )
        for index, (title, description, icon_name, page_name) in enumerate(home_cards):
            button = Gtk.Button()
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.get_style_context().add_class("rivet-card")
            button.connect("clicked", self.select_page, page_name)
            card_content = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.DIALOG)
            icon.set_pixel_size(30)
            card_content.pack_start(icon, False, False, 0)
            labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            name = Gtk.Label(label=title)
            name.set_xalign(0)
            name.get_style_context().add_class("rivet-card-title")
            labels.pack_start(name, False, False, 0)
            details = Gtk.Label(label=description)
            details.set_xalign(0)
            details.set_line_wrap(True)
            details.get_style_context().add_class("rivet-card-description")
            labels.pack_start(details, False, False, 0)
            card_content.pack_start(labels, True, True, 0)
            button.add(card_content)
            quick.attach(button, index % 2, index // 2, 1, 1)
        content.pack_start(quick, False, False, 0)

        system_summary = Gtk.Label(label=load_os_summary())
        system_summary.set_xalign(0)
        system_summary.get_style_context().add_class("rivet-muted")
        content.pack_start(system_summary, False, False, 10)
        return scroll

    def build_settings_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        page.set_border_width(24)
        self.page_heading(
            page,
            "System settings",
            "Search or browse settings. Each card opens the relevant native Rivet/XFCE tool.",
        )

        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search settings, devices, apps...")
        self.search.connect("changed", self.filter_settings)
        page.pack_start(self.search, False, False, 0)

        self.settings_count = Gtk.Label(label="")
        self.settings_count.set_xalign(0)
        self.settings_count.get_style_context().add_class("rivet-muted")
        page.pack_start(self.settings_count, False, False, 0)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_min_children_per_line(1)
        flow.set_max_children_per_line(3)
        flow.set_column_spacing(12)
        flow.set_row_spacing(12)
        flow.set_homogeneous(True)
        flow.set_valign(Gtk.Align.START)
        flow.set_hexpand(True)

        self.setting_items = []
        for category, entries in SETTINGS_GROUPS:
            for title, description, icon_name, command in entries:
                card = self.make_card(title, description, icon_name, command, category)
                child = Gtk.FlowBoxChild()
                child.set_hexpand(True)
                child.add(card)
                flow.add(child)
                search_terms = " ".join((category, title, description, " ".join(command))).casefold()
                self.setting_items.append((child, search_terms))

        scroller.add(flow)
        page.pack_start(scroller, True, True, 0)
        self.filter_settings()
        return page

    def filter_settings(self, *_):
        if not hasattr(self, "setting_items"):
            return
        query = self.search.get_text().strip().casefold()
        visible = 0
        for child, terms in self.setting_items:
            matches = not query or query in terms
            child.set_visible(matches)
            if matches:
                visible += 1
        self.settings_count.set_text(
            f"{visible} settings and tools" if not query
            else f"{visible} result{'s' if visible != 1 else ''}"
        )

    def build_tools_page(self):
        scroll, content = self.new_scrolled_page()
        self.page_heading(
            content,
            "Rivet tools",
            "Small utilities built into Rivet, alongside a few useful desktop tools.",
        )
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_min_children_per_line(1)
        flow.set_max_children_per_line(2)
        flow.set_column_spacing(12)
        flow.set_row_spacing(12)
        flow.set_homogeneous(True)
        for title, description, icon_name, command in QUICK_TOOLS:
            card = self.make_card(title, description, icon_name, command, "Rivet tools")
            child = Gtk.FlowBoxChild()
            child.set_hexpand(True)
            child.add(card)
            flow.add(child)
        content.pack_start(flow, False, False, 0)
        return scroll

    def build_about_page(self):
        scroll, content = self.new_scrolled_page()
        self.page_heading(
            content,
            "About Rivet",
            "A Debian-based desktop built around control, clarity and everyday usefulness.",
        )
        facts = (
            ("Base", "Debian GNU/Linux"),
            ("Desktop", "XFCE"),
            ("Audio", "PipeWire and WirePlumber"),
            ("Network", "NetworkManager"),
            ("Installer", "Calamares"),
            ("Mascot", "Chip the beaver"),
        )
        grid = Gtk.Grid()
        grid.set_column_spacing(18)
        grid.set_row_spacing(14)
        for index, (key, value) in enumerate(facts):
            name = Gtk.Label(label=key)
            name.set_xalign(0)
            name.get_style_context().add_class("rivet-muted")
            value_label = Gtk.Label(label=value)
            value_label.set_xalign(0)
            value_label.set_line_wrap(True)
            grid.attach(name, 0, index, 1, 1)
            grid.attach(value_label, 1, index, 1, 1)
        content.pack_start(grid, False, False, 4)

        note = Gtk.Label(
            label="Welcome to Rivet is a local application. It does not send system "
                  "information anywhere. Settings are opened using the tools already "
                  "provided by the desktop."
        )
        note.set_line_wrap(True)
        note.set_xalign(0)
        note.set_max_width_chars(92)
        content.pack_start(note, False, False, 8)
        return scroll

    def select_page(self, _button, page_name):
        self.stack.set_visible_child_name(page_name)

    def launch_command(self, _button, command, title):
        executable = command[0]
        if shutil.which(executable) is None:
            self.status.set_text(
                f"{title} is not available. Check whether its package is installed."
            )
            return
        try:
            subprocess.Popen(
                list(command), close_fds=True, start_new_session=True
            )
            self.status.set_text(f"Opened {title}.")
        except OSError as error:
            self.status.set_text(f"Could not open {title}: {error}")

    def on_close(self, *_):
        try:
            mark_welcome_seen()
        except OSError as error:
            print(f"Could not save the welcome preference: {error}", file=sys.stderr)
        Gtk.main_quit()
        return False

    def show(self):
        self.window.show_all()
        self.window.present()


def main():
    if is_live_session():
        return 0
    if MARKER.exists() and "--show-again" not in sys.argv:
        return 0

    try:
        app = RivetWelcomeCenter()
        app.show()
        Gtk.main()
    except Exception as error:
        print(f"Welcome to Rivet could not start: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
