#!/usr/bin/python3
"""Launch Debian's Calamares helper and diagnose failures without hiding them."""

from datetime import datetime
import os
from pathlib import Path
import re
import subprocess
import time

STOCK_LAUNCHER = "/usr/bin/calamares-install-debian"
PIPELINE_CHECKER = "/usr/lib/rivet/check-installer-pipeline.py"
POLKIT_AGENT = "/usr/libexec/polkit-mate-authentication-agent-1"
WINDOW_TITLE = "Rivet Linux Installer"
WINDOW_CLASS = "calamares"
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local/state"))
LOG_PATH = STATE_HOME / "rivet" / "installer-launch.log"
ROOT_CALAMARES_LOG = "/root/.cache/calamares/session.log"
WATCH_SECONDS = 20

try:
    import gi

    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk
    GTK_IMPORT_ERROR = None
except Exception as error:
    Gtk = None
    GTK_IMPORT_ERROR = f"{type(error).__name__}: {error}"


def write_log(message):
    """Write diagnostics, falling back to /tmp if the user's state directory is unavailable."""
    line = message.rstrip() + "\n"
    for path in (LOG_PATH, Path("/tmp/rivet-installer-launch.log")):
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            with path.open("a", encoding="utf-8") as log:
                log.write(line)
            return
        except OSError:
            continue


def live_processes():
    """List relevant processes using exe/cmdline; /proc/PID/comm truncates long names."""
    found = []
    try:
        entries = list(Path("/proc").iterdir())
    except OSError as error:
        return [f"Could not inspect /proc: {error}"]

    targets = {"calamares", "pkexec", "polkit-mate-authentication-agent-1"}
    for entry in entries:
        if not entry.name.isdigit():
            continue
        try:
            executable = os.readlink(entry / "exe").removesuffix(" (deleted)")
            executable_name = Path(executable).name
            raw_command = (entry / "cmdline").read_bytes()
            command_line = raw_command.replace(b"\0", b" ").decode("utf-8", errors="replace").strip()
            if executable_name in targets or "polkit-mate-authentication-agent-1" in command_line:
                found.append(f"{executable_name} (PID {entry.name}; argv={command_line[:240]})")
        except (OSError, UnicodeError):
            continue
    return found


def _command(command, timeout=3):
    try:
        return subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            check=False,
        ), None
    except (OSError, subprocess.TimeoutExpired) as error:
        return None, f"{' '.join(command)} failed: {error}"


def installer_window_state():
    """Find a mapped Calamares top-level window by WM_CLASS, not translated title text."""
    problems = []
    window_ids = []
    fallback_titles = {}

    clients, error = _command(["xprop", "-root", "_NET_CLIENT_LIST_STACKING"])
    if error:
        problems.append(error)
    elif clients.returncode == 0:
        window_ids = re.findall(r"0x[0-9a-fA-F]+", clients.stdout)
    else:
        problems.append(clients.stderr.strip() or "Could not read _NET_CLIENT_LIST_STACKING.")

    if not window_ids:
        tree, error = _command(["xwininfo", "-root", "-tree"])
        if error:
            problems.append(error)
            return None, "; ".join(problems)
        if tree.returncode != 0:
            problems.append(tree.stderr.strip() or f"xwininfo exited with status {tree.returncode}")
            return None, "; ".join(problems)

        for line in tree.stdout.splitlines():
            match = re.match(r"\s*(0x[0-9a-fA-F]+)\s+", line)
            if match:
                window_id = match.group(1)
                if window_id not in fallback_titles:
                    window_ids.append(window_id)
                fallback_titles[window_id] = line

    for window_id in window_ids:
        props, error = _command([
            "xprop", "-id", window_id, "WM_CLASS", "_NET_WM_NAME", "WM_NAME"
        ])
        if error:
            problems.append(error)
            continue
        if props.returncode != 0:
            continue

        properties = props.stdout
        known_title = fallback_titles.get(window_id, "")
        is_calamares = WINDOW_CLASS.casefold() in properties.casefold()
        title_matches = WINDOW_TITLE.casefold() in (properties + known_title).casefold()
        if not is_calamares and not title_matches:
            continue

        details, error = _command(["xwininfo", "-id", window_id])
        if error:
            problems.append(error)
            continue
        if details.returncode == 0 and "Map State: IsViewable" in details.stdout:
            return window_id, None

    return None, "; ".join(dict.fromkeys(problems)) if problems else None


def root_calamares_log_signature():
    """Return a precise signature of the root-owned session.log, without reading stale contents."""
    result, error = _command([
        "sudo", "-n", "stat", "-c", "%s|%y|%i", ROOT_CALAMARES_LOG
    ], timeout=5)
    if error:
        return None, error
    if result.returncode != 0:
        detail = result.stderr.strip() or f"stat exited with status {result.returncode}"
        return None, detail
    return result.stdout.strip(), None


def append_root_calamares_log(previous_signature, previous_error):
    """Append session.log only if this launch created or updated it."""
    current_signature, current_error = root_calamares_log_signature()
    if current_signature is None:
        write_log(f"Could not inspect Calamares session.log after launch: {current_error}")
        return

    if previous_signature is not None and current_signature == previous_signature:
        write_log("Existing session.log is unchanged; omitting it to avoid stale diagnostics.")
        return

    if previous_signature is None and previous_error:
        error_lower = previous_error.casefold()
        file_was_absent = "no such file" in error_lower or "cannot stat" in error_lower
        if not file_was_absent:
            write_log(
                "The session.log baseline could not be read before launch; "
                "omitting the file because it may be stale."
            )
            return

    result, error = _command([
        "sudo", "-n", "tail", "-n", "160", ROOT_CALAMARES_LOG
    ], timeout=5)
    if error:
        write_log(f"Could not retrieve Calamares session.log: {error}")
    elif result.returncode == 0:
        write_log(f"===== Current-attempt tail of {ROOT_CALAMARES_LOG} =====")
        write_log(result.stdout if result.stdout.strip() else "<session.log is empty>")
    else:
        detail = result.stderr.strip() or f"tail exited with status {result.returncode}"
        write_log(f"Could not retrieve Calamares session.log: {detail}")


def show_diagnostics(message):
    try:
        log_text = LOG_PATH.read_text(encoding="utf-8", errors="replace")
    except OSError as error:
        log_text = f"Could not read diagnostic log: {error}"
    log_text = log_text[-24000:]
    display_message = f"{message}\n\nDiagnostic log: {LOG_PATH}"

    if Gtk is None:
        write_log(f"GTK diagnostic dialog unavailable: {GTK_IMPORT_ERROR}")
        try:
            subprocess.Popen(["xmessage", "-center", display_message], close_fds=True)
        except OSError as error:
            write_log(f"xmessage fallback unavailable: {error}")
        return

    try:
        dialog = Gtk.Dialog(title="Rivet Installer Diagnostics", flags=Gtk.DialogFlags.MODAL)
        dialog.add_button("Close", Gtk.ResponseType.CLOSE)
        dialog.set_default_size(900, 540)
        dialog.set_border_width(12)

        content = dialog.get_content_area()
        heading = Gtk.Label(label=message)
        heading.set_line_wrap(True)
        heading.set_xalign(0)
        content.pack_start(heading, False, False, 8)

        location = Gtk.Label(
            label=f"Diagnostic log: {LOG_PATH}\nYou can select and copy the log below."
        )
        location.set_line_wrap(True)
        location.set_xalign(0)
        content.pack_start(location, False, False, 6)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        text_view = Gtk.TextView()
        text_view.set_editable(False)
        text_view.set_cursor_visible(False)
        text_view.set_monospace(True)
        text_view.get_buffer().set_text(log_text)
        scroller.add(text_view)
        content.pack_start(scroller, True, True, 6)

        dialog.show_all()
        dialog.run()
        dialog.destroy()
    except Exception as error:
        write_log(f"GTK diagnostic dialog failed: {type(error).__name__}: {error}")
        try:
            subprocess.Popen(["xmessage", "-center", display_message], close_fds=True)
        except OSError as fallback_error:
            write_log(f"xmessage fallback unavailable: {fallback_error}")


def main():
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOG_PATH.open("a", encoding="utf-8") as log:
        log.write(
            "\n===== Rivet installer launch: "
            + datetime.now().astimezone().isoformat()
            + " =====\n"
        )
        log.write(f"uid={os.getuid()} user={os.environ.get('USER', '')}\n")
        for key in (
            "DISPLAY", "XAUTHORITY", "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP", "XDG_SESSION_ID"
        ):
            log.write(f"{key}={os.environ.get(key, '<unset>')}\n")
        for path in (
            STOCK_LAUNCHER, "/usr/bin/calamares", "/usr/bin/pkexec", "/usr/bin/xhost",
            "/usr/bin/sudo", "/usr/bin/xwininfo", "/usr/bin/xprop", "/usr/bin/xmessage",
            POLKIT_AGENT,
        ):
            log.write(
                f"check {path}: exists={os.path.exists(path)} "
                f"executable={os.access(path, os.X_OK)}\n"
            )
        if GTK_IMPORT_ERROR:
            log.write(f"WARNING: GTK diagnostic UI unavailable: {GTK_IMPORT_ERROR}\n")
        log.flush()

    if not os.path.isfile(STOCK_LAUNCHER) or not os.access(STOCK_LAUNCHER, os.X_OK):
        write_log("ERROR: Debian's Calamares launcher is missing or not executable.")
        show_diagnostics("The Debian Calamares launcher is missing or cannot be executed.")
        return 1

    if not os.path.isfile(PIPELINE_CHECKER):
        write_log(f"ERROR: Rivet installer pipeline checker is missing: {PIPELINE_CHECKER}")
        show_diagnostics(
            "Rivet cannot verify that disk setup, system extraction, and bootloader installation "
            "are configured correctly. The installer was not started."
        )
        return 1

    result, error = _command(
        ["/usr/bin/python3", PIPELINE_CHECKER, "--root", "/"],
        timeout=8,
    )
    if error:
        write_log(f"ERROR: could not run installer pipeline preflight: {error}")
        show_diagnostics("Rivet could not validate the installation pipeline. The installer was not started.")
        return 1
    if result.returncode != 0:
        write_log("ERROR: installer pipeline preflight failed.")
        write_log(result.stdout.strip())
        write_log(result.stderr.strip())
        show_diagnostics(
            "Rivet's installation pipeline is incomplete or misconfigured. "
            "The installer was not started; see the diagnostic report."
        )
        return 1

    write_log("Installer pipeline preflight passed: " + result.stdout.strip())

    log_signature_before, log_signature_error = root_calamares_log_signature()
    if log_signature_error:
        write_log(f"Could not capture pre-launch session.log baseline: {log_signature_error}")

    try:
        with LOG_PATH.open("a", encoding="utf-8") as log:
            process = subprocess.Popen(
                [STOCK_LAUNCHER],
                stdout=log,
                stderr=subprocess.STDOUT,
                close_fds=True,
                start_new_session=True,
            )
    except OSError as error:
        write_log(f"ERROR: could not start Debian's launcher: {error!r}")
        show_diagnostics("Rivet could not start Debian's installer launcher.")
        return 1

    deadline = time.monotonic() + WATCH_SECONDS
    last_window_error = None
    while time.monotonic() < deadline:
        window_id, window_error = installer_window_state()
        if window_error and window_error != last_window_error:
            write_log(window_error)
            last_window_error = window_error

        if window_id:
            write_log(f"SUCCESS: visible Calamares window detected: {window_id}")
            return 0

        return_code = process.poll()
        if return_code is not None:
            time.sleep(0.3)
            window_id, window_error = installer_window_state()
            if window_id:
                write_log(f"SUCCESS: visible Calamares window detected after launcher exit: {window_id}")
                return 0

            processes = live_processes()
            write_log(
                f"ERROR: Debian launcher exited with status {return_code} "
                "before a visible installer window appeared."
            )
            write_log("Processes observed: " + (", ".join(processes) if processes else "<none>"))
            if window_error:
                write_log(window_error)
            append_root_calamares_log(log_signature_before, log_signature_error)
            show_diagnostics(
                "The Debian launcher exited before a visible Calamares window appeared. "
                "Review the captured launcher output and current-attempt session log below."
            )
            return 1

        time.sleep(0.8)

    processes = live_processes()
    write_log(f"WARNING: no visible Calamares window detected after {WATCH_SECONDS} seconds.")
    write_log("Processes observed: " + (", ".join(processes) if processes else "<none>"))
    write_log("A running process alone is not considered proof that the installer window opened.")
    if last_window_error:
        write_log(last_window_error)
    append_root_calamares_log(log_signature_before, log_signature_error)
    show_diagnostics(
        "No visible Calamares window was detected within 20 seconds. "
        "The launcher was not killed. Check for an authentication prompt and inspect the captured logs."
    )
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
