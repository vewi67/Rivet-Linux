#!/bin/sh
set -eu

RIVET_WALLPAPER_DIR="/usr/share/backgrounds/rivet"
RIVET_WALLPAPER="${RIVET_WALLPAPER_DIR}/rivet-waves.jpeg"
RIVET_LOGIN_WALLPAPER="${RIVET_WALLPAPER_DIR}/rivet-prism.jpeg"
RIVET_LOGO="/etc/calamares/branding/rivet/rivet.logo.png"
RIVET_ICON="/usr/share/icons/hicolor/256x256/apps/rivet.png"

# Fail early if any required visual asset is absent or empty.
for asset in \
  "${RIVET_WALLPAPER_DIR}/rivet-waves.jpeg" \
  "${RIVET_WALLPAPER_DIR}/rivet-factory.jpeg" \
  "${RIVET_WALLPAPER_DIR}/rivet-chip.jpeg" \
  "${RIVET_LOGIN_WALLPAPER}" \
  "${RIVET_LOGO}"; do
  if [ ! -s "$asset" ]; then
    echo "ERROR: required Rivet visual asset missing: $asset" >&2
    exit 1
  fi
done

# Set the default wallpaper in the system defaults and new-user profile.
for config_dir in \
  "/etc/xdg/xfce4/xfconf/xfce-perchannel-xml" \
  "/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml"; do
  mkdir -p "$config_dir"
  cat > "$config_dir/xfce4-desktop.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="image-path" type="string" value="$RIVET_WALLPAPER"/>
        <property name="image-style" type="int" value="5"/>
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="$RIVET_WALLPAPER"/>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF
done

# XFCE may use monitorVirtual1 or another real display name instead of monitor0.
# Apply the default after XFCE creates the live user's actual backdrop properties.
cat > /usr/local/bin/rivet-set-wallpaper <<'EOF'
#!/bin/sh
set -eu

WALLPAPER="/usr/share/backgrounds/rivet/rivet-waves.jpeg"
LOG_DIR="$HOME/.cache/rivet"
mkdir -p "$LOG_DIR"
exec >> "$LOG_DIR/wallpaper-default.log" 2>&1

if [ ! -s "$WALLPAPER" ]; then
  echo "ERROR: Rivet Waves wallpaper is missing: $WALLPAPER"
  exit 1
fi

# XFCE 4.20 can use monitor-level properties or workspace-level properties.
# Replace Debian/XFCE stock images and missing paths, but preserve valid images
# chosen by the user.
needs_replacement() {
  image="$1"
  case "$image" in
    ""|"$WALLPAPER"|/usr/share/images/desktop-base/*|/usr/share/backgrounds/xfce/*|/usr/share/xfce4/backdrops/*)
      return 0
      ;;
  esac
  [ ! -f "$image" ] && return 0
  return 1
}

set_style_for_property() {
  property="$1"
  parent="$(dirname "$property")"
  xfconf-query -c xfce4-desktop -p "$parent/image-style" --create --type int --set 5 >/dev/null 2>&1
  xfconf-query -c xfce4-desktop -p "$parent/color-style" --create --type int --set 0 >/dev/null 2>&1
}

set_wallpaper() {
  property="$1"
  if ! xfconf-query -c xfce4-desktop -p "$property" --create --type string --set "$WALLPAPER" >/dev/null 2>&1; then
    echo "ERROR: could not set wallpaper property: $property"
    return 1
  fi
  current="$(xfconf-query -c xfce4-desktop -p "$property" 2>/dev/null || true)"
  if [ "$current" != "$WALLPAPER" ]; then
    echo "ERROR: wallpaper property did not retain Rivet Waves: $property ($current)"
    return 1
  fi
  if ! set_style_for_property "$property"; then
    echo "ERROR: could not set wallpaper fit/style for: $property"
    return 1
  fi
  echo "Set Rivet Waves: $property"
  return 0
}

get_backdrop_properties() {
  xfconf-query -c xfce4-desktop -lv 2>/dev/null |
    awk '$1 ~ /^\/backdrop\/screen[0-9]+\/.*\/(last-image|last-single-image|image-path)$/ {print $1}' || true
}

# Wait for xfdesktop and its monitor configuration. Do not assume the property
# path contains /workspaceN: that assumption fails on some Trixie/XFCE setups.
attempt=0
properties=""
while [ "$attempt" -lt 30 ]; do
  if pgrep -x xfdesktop >/dev/null 2>&1; then
    properties="$(get_backdrop_properties)"
    monitors="$(xrandr --query 2>/dev/null | awk '/ connected/{print $1}' || true)"
    if [ -n "$properties" ] || [ -n "$monitors" ]; then
      break
    fi
  fi
  attempt=$((attempt + 1))
  sleep 1
done

# Build screen/monitor pairs from both properties already exposed by XFCE and
# active XRandR outputs. This covers monitor0, monitorDP-1, monitorVirtual-1,
# and monitordefault, without hardcoding one physical display name.
pairs="$(
  {
    printf '%s\n' "$properties" |
      sed -nE 's#^/backdrop/(screen[0-9]+)/monitor([^/]+)/.*#\1 \2#p'
    xrandr --query 2>/dev/null | awk '/ connected/{printf "screen0 %s\n", $1}' || true
  } | sort -u
)"
if [ -z "$pairs" ]; then
  pairs="screen0 default"
fi

workspaces="$(xfconf-query -c xfwm4 -p /general/workspace_count 2>/dev/null || true)"
case "$workspaces" in
  ""|*[!0-9]*) workspaces=4 ;;
esac
if [ "$workspaces" -lt 1 ] || [ "$workspaces" -gt 32 ]; then
  workspaces=4
fi

# Do several passes because xfdesktop may create or migrate its active monitor
# properties after the first autostart entries have already begun.
round=1
while [ "$round" -le 3 ]; do
  properties="$(get_backdrop_properties)"
  failed=0

  # First fix every existing current-image or legacy-image property, including
  # properties that do not contain a workspace number.
  for property in $properties; do
    current="$(xfconf-query -c xfce4-desktop -p "$property" 2>/dev/null || true)"
    if needs_replacement "$current"; then
      if ! set_wallpaper "$property"; then
        failed=1
      fi
    else
      echo "Preserving user wallpaper: $property ($current)"
    fi
  done

  # Ensure each monitor/workspace has an explicit last-image property, which
  # is the binding used by modern xfdesktop. Respect a valid custom monitor-
  # level image instead of overriding it with the default.
  while IFS=' ' read -r screen monitor; do
    [ -n "$screen" ] && [ -n "$monitor" ] || continue
    monitor_root="/backdrop/$screen/monitor$monitor"
    custom_base=0

    for base_property in \
      "$monitor_root/last-image" \
      "$monitor_root/last-single-image" \
      "$monitor_root/image-path"; do
      if printf '%s\n' "$properties" | grep -Fxq "$base_property"; then
        base_value="$(xfconf-query -c xfce4-desktop -p "$base_property" 2>/dev/null || true)"
        if ! needs_replacement "$base_value"; then
          custom_base=1
        fi
      fi
    done

    workspace=0
    while [ "$workspace" -lt "$workspaces" ]; do
      property="$monitor_root/workspace$workspace/last-image"
      if ! printf '%s\n' "$properties" | grep -Fxq "$property"; then
        if [ "$custom_base" -eq 0 ]; then
          if ! set_wallpaper "$property"; then
            failed=1
          fi
        else
          echo "Preserving custom monitor-level wallpaper for $monitor_root"
        fi
      fi
      workspace=$((workspace + 1))
    done
  done <<PAIR_LIST
$pairs
PAIR_LIST

  if [ "$failed" -ne 0 ]; then
    echo "WARNING: one or more wallpaper properties could not be set in pass $round."
  fi
  xfdesktop --reload >/dev/null 2>&1 || true
  sleep 2
  round=$((round + 1))
done

# Verify that no Debian/XFCE stock image or missing image path remains in the
# active xfconf backdrop properties. Custom, existing user-selected images are
# deliberately allowed.
properties="$(get_backdrop_properties)"
unresolved=0
verified=0
for property in $properties; do
  current="$(xfconf-query -c xfce4-desktop -p "$property" 2>/dev/null || true)"
  if [ "$current" = "$WALLPAPER" ]; then
    verified=$((verified + 1))
  elif needs_replacement "$current"; then
    echo "ERROR: unresolved default/missing wallpaper: $property ($current)"
    unresolved=1
  fi
done

if [ "$unresolved" -ne 0 ]; then
  echo "ERROR: Rivet wallpaper configuration could not be fully verified."
  exit 1
fi

# Older builds used a one-time marker. Remove it because this script now checks
# every login, repairs distro defaults, and leaves valid user wallpapers alone.
rm -f "$HOME/.config/rivet/wallpaper-default-applied"
if [ "$verified" -gt 0 ]; then
  echo "Rivet Waves wallpaper properties verified; user-selected wallpapers are preserved."
else
  echo "No stock wallpaper needed replacing; existing user-selected wallpapers were preserved."
fi

# Activate the native XFCE cycler after repairing the initial wallpaper.
if [ -x /usr/bin/rivet-wallpaper-guard ]; then
  if /usr/bin/rivet-wallpaper-guard --once; then
    echo "Rivet Atmosphere settings applied."
  else
    echo "WARNING: Rivet Atmosphere could not apply its initial settings."
  fi
fi
EOF
chmod 0755 /usr/local/bin/rivet-set-wallpaper
mkdir -p /etc/xdg/autostart /etc/skel/.config/autostart
cat > /etc/xdg/autostart/rivet-wallpaper.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Rivet Wallpaper Defaults
Comment=Set the initial Rivet desktop wallpaper
Exec=/usr/local/bin/rivet-set-wallpaper
OnlyShowIn=XFCE;
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF
cp /etc/xdg/autostart/rivet-wallpaper.desktop /etc/skel/.config/autostart/rivet-wallpaper.desktop

# Rivet Atmosphere uses xfdesktop's native backdrop cycler, with a small
# control panel. It adds no animation daemon and preserves personal wallpapers.
for atmosphere_file in \
  /usr/bin/rivet-wallpaper-guard \
  /usr/bin/rivet-atmosphere \
  /usr/share/applications/rivet-atmosphere.desktop; do
  if [ ! -s "$atmosphere_file" ]; then
    echo "ERROR: Rivet Atmosphere component is missing: $atmosphere_file" >&2
    exit 1
  fi
done
chmod 0755 /usr/bin/rivet-wallpaper-guard /usr/bin/rivet-atmosphere
cat > /etc/xdg/autostart/rivet-wallpaper-guard.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Rivet Atmosphere Service
Comment=Keep Rivet wallpaper ambience in sync with XFCE
Exec=/usr/bin/rivet-wallpaper-guard
OnlyShowIn=XFCE;
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF
cp /etc/xdg/autostart/rivet-wallpaper-guard.desktop /etc/skel/.config/autostart/rivet-wallpaper-guard.desktop
mkdir -p /etc/skel/.config/rivet
printf 'ambient\n' > /etc/skel/.config/rivet/atmosphere-mode

# Keep Plank as the app dock and provide a thin top status bar.
# NetworkManager's nm-applet requires an XDG system tray to expose Wi-Fi networks.
# This panel only hosts the system tray and clock; it does not duplicate Plank's dock.
for panel_file in \
  "/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml" \
  "/etc/xdg/xfce4/panel/default.xml" \
  "/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"; do
  mkdir -p "$(dirname "$panel_file")"
  cat > "$panel_file" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="length-adjust" type="bool" value="true"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="26"/>
      <property name="icon-size" type="uint" value="16"/>
      <property name="nrows" type="uint" value="1"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
      </property>
      <property name="background-style" type="uint" value="0"/>
      <property name="enter-opacity" type="uint" value="100"/>
      <property name="leave-opacity" type="uint" value="100"/>
      <property name="mode" type="uint" value="0"/>
      <property name="autohide-behavior" type="uint" value="0"/>
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="systray">
      <property name="show-frame" type="bool" value="false"/>
      <property name="size-max" type="uint" value="22"/>
    </property>
    <property name="plugin-2" type="string" value="clock">
      <property name="digital-format" type="string" value="%H:%M"/>
      <property name="tooltip-format" type="string" value="%A %d %B %Y"/>
    </property>
  </property>
</channel>
EOF
done

# Remove the old startup override that killed the entire XFCE panel.
rm -f \
  /usr/local/bin/rivet-disable-xfce-panel \
  /etc/xdg/autostart/rivet-disable-xfce-panel.desktop \
  /etc/skel/.config/autostart/rivet-disable-xfce-panel.desktop


# Use the GTK greeter and the dedicated Rivet login wallpaper.
mkdir -p /etc/lightdm/lightdm.conf.d /etc/lightdm
cat > /etc/lightdm/lightdm.conf.d/10-rivet.conf <<'EOF'
[Seat:*]
greeter-session=lightdm-gtk-greeter
EOF

cat > /etc/lightdm/lightdm-gtk-greeter.conf <<EOF
[greeter]
background=$RIVET_LOGIN_WALLPAPER
EOF

# The packaged MATE agent may be restricted to the MATE session. Explicitly
# start its authentication agent in Rivet's XFCE session so pkexec can show
# the authorization dialog when the installer is launched.
POLKIT_AGENT="/usr/libexec/polkit-mate-authentication-agent-1"
if [ ! -x "$POLKIT_AGENT" ]; then
  echo "ERROR: PolicyKit authentication agent is missing: $POLKIT_AGENT" >&2
  exit 1
fi
cat > /etc/xdg/autostart/rivet-polkit-agent.desktop <<'EOF'
[Desktop Entry]
Type=Application
Version=1.0
Name=Rivet Authorization Agent
Comment=Authorize administrative actions in Rivet
Exec=/usr/libexec/polkit-mate-authentication-agent-1
TryExec=/usr/libexec/polkit-mate-authentication-agent-1
OnlyShowIn=XFCE;
NoDisplay=true
Terminal=false
X-GNOME-Autostart-enabled=true
EOF

# Keep Debian's own launcher logic for display authorization and temporary fstab handling.
# Point Calamares at Rivet branding while preserving Debian's tested module sequence.
CALAMARES_SETTINGS="/etc/calamares/settings.conf"
if [ ! -s "$CALAMARES_SETTINGS" ]; then
  echo "ERROR: Calamares settings file is missing: $CALAMARES_SETTINGS" >&2
  exit 1
fi
if ! grep -Eq '^[[:space:]]*branding:[[:space:]]*debian[[:space:]]*$' "$CALAMARES_SETTINGS"; then
  echo "ERROR: expected Debian branding entry in $CALAMARES_SETTINGS." >&2
  exit 1
fi
sed -i 's/^[[:space:]]*branding:[[:space:]]*debian[[:space:]]*$/branding: rivet/' "$CALAMARES_SETTINGS"

# Add a last explicit confirmation before destructive disk work. Once file
# systems and boot records are being written, prevent accidental cancellation.
for setting in prompt-install disable-cancel-during-exec; do
  if ! grep -Eq "^[[:space:]]*${setting}:[[:space:]]*(true|false)[[:space:]]*(#.*)?$" "$CALAMARES_SETTINGS"; then
    echo "ERROR: required Calamares installation-safety setting is missing: ${setting}" >&2
    exit 1
  fi
done
sed -Ei 's/^[[:space:]]*prompt-install:[[:space:]]*.*/prompt-install: true/' "$CALAMARES_SETTINGS"
sed -Ei 's/^[[:space:]]*disable-cancel-during-exec:[[:space:]]*.*/disable-cancel-during-exec: true/' "$CALAMARES_SETTINGS"

mkdir -p /etc/calamares/branding/rivet
BRANDING_DESC="/etc/calamares/branding/rivet/branding.desc"
if [ ! -s "$BRANDING_DESC" ]; then
  echo "ERROR: Rivet Calamares branding descriptor is missing: $BRANDING_DESC" >&2
  exit 1
fi

# Install the Rivet icon for the desktop and welcome application.
mkdir -p "$(dirname "$RIVET_ICON")"
cp "$RIVET_LOGO" "$RIVET_ICON"
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -f -t /usr/share/icons/hicolor
fi

# Keep Debian's packaged launcher script and installer module sequence intact.
# Rivet uses a separate branded desktop entry that points to this same helper.
INSTALLER="/usr/bin/calamares-install-debian"
DEBIAN_INSTALLER_DESKTOP="/usr/share/applications/calamares-install-debian.desktop"
RIVET_INSTALLER_DESKTOP="/usr/share/applications/rivet-installer.desktop"
if [ ! -x "$INSTALLER" ]; then
  echo "ERROR: Calamares launcher is missing or not executable: $INSTALLER" >&2
  exit 1
fi
if [ ! -s "$DEBIAN_INSTALLER_DESKTOP" ]; then
  echo "ERROR: Debian's Calamares desktop entry is missing: $DEBIAN_INSTALLER_DESKTOP" >&2
  exit 1
fi
if [ ! -s "$RIVET_INSTALLER_DESKTOP" ]; then
  echo "ERROR: Rivet's branded Calamares desktop entry is missing: $RIVET_INSTALLER_DESKTOP" >&2
  exit 1
fi

# Hide the original menu entry instead of editing its name, icon, or command.
if ! grep -Fxq 'NoDisplay=true' "$DEBIAN_INSTALLER_DESKTOP"; then
  sed -i '/^\[Desktop Entry\]/aNoDisplay=true' "$DEBIAN_INSTALLER_DESKTOP"
fi

# Debian's helper creates an unbranded desktop shortcut on login; Rivet provides its own.
rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop


if [ ! -s /usr/bin/rivet-welcome ]; then
  echo "ERROR: Rivet welcome application is missing." >&2
  exit 1
fi
chmod 0755 /usr/bin/rivet-welcome

# Keep the expected desktop integration present in the built image.
if [ ! -s /etc/xdg/autostart/rivet-plank.desktop ]; then
  echo "ERROR: Plank autostart entry is missing." >&2
  exit 1
fi

# Give new live and installed accounts a populated bottom dock, separate from the top status bar.
PLANK_DIR="/etc/skel/.config/plank/dock1"
PLANK_LAUNCHERS="${PLANK_DIR}/launchers"
mkdir -p "$PLANK_LAUNCHERS"
cat > "${PLANK_DIR}/settings" <<'EOF'
[PlankDockPreferences]
DockItems=Firefox.dockitem;Files.dockitem;Install-Rivet.dockitem;Settings.dockitem;Atmosphere.dockitem;
IconSize=48
Position=3
Alignment=3
ItemsAlignment=3
HideMode=0
ZoomEnabled=true
ZoomPercent=150
TooltipsEnabled=true
EOF

cat > "${PLANK_LAUNCHERS}/Firefox.dockitem" <<'EOF'
[PlankDockItemPreferences]
Launcher=file:///usr/share/applications/firefox-esr.desktop
EOF
cat > "${PLANK_LAUNCHERS}/Files.dockitem" <<'EOF'
[PlankDockItemPreferences]
Launcher=file:///usr/share/applications/thunar.desktop
EOF
cat > "${PLANK_LAUNCHERS}/Install-Rivet.dockitem" <<'EOF'
[PlankDockItemPreferences]
Launcher=file:///usr/share/applications/rivet-installer.desktop
EOF
cat > /usr/share/applications/rivet-settings.desktop <<'EOF'
[Desktop Entry]
Type=Application
Version=1.0
Name=Rivet Settings
Comment=Configure the Rivet desktop
Exec=xfce4-settings-manager
Icon=preferences-desktop
Terminal=false
Categories=Settings;DesktopSettings;
EOF
cat > "${PLANK_LAUNCHERS}/Settings.dockitem" <<'EOF'
[PlankDockItemPreferences]
Launcher=file:///usr/share/applications/rivet-settings.desktop
EOF

cat > "${PLANK_LAUNCHERS}/Atmosphere.dockitem" <<'EOF'
[PlankDockItemPreferences]
Launcher=file:///usr/share/applications/rivet-atmosphere.desktop
EOF

if ! grep -Eq '^[[:space:]]*branding:[[:space:]]*rivet[[:space:]]*$' "$CALAMARES_SETTINGS"; then
  echo "ERROR: Calamares branding was not switched to Rivet." >&2
  exit 1
fi

echo "Rivet desktop, Atmosphere, dock, installer authentication, branding, and welcome experience configured."
