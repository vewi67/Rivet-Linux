#!/bin/sh
set -eu

RIVET_WALLPAPER_DIR="/usr/share/backgrounds/rivet"
RIVET_WALLPAPER="${RIVET_WALLPAPER_DIR}/rivet-waves.jpeg"
RIVET_LOGIN_WALLPAPER="${RIVET_WALLPAPER_DIR}/rivet-prism.jpeg"
RIVET_LOGO="/etc/calamares/branding/rivet/rivet.logo.png"

# Fail the build if a required visual asset is missing or empty.
for asset in \
  "${RIVET_WALLPAPER_DIR}/rivet-waves.jpeg" \
  "${RIVET_WALLPAPER_DIR}/rivet-factory.jpeg" \
  "${RIVET_WALLPAPER_DIR}/rivet-chip.jpeg" \
  "${RIVET_LOGIN_WALLPAPER}" \
  "${RIVET_LOGO}"; do
  if [ ! -s "$asset" ]; then
    echo "ERROR: required Rivet visual asset missing: $asset" >&2
    exit 1
  fi
done

# Set the default XFCE wallpaper for the live session and newly created users.
for config_dir in \
  "/etc/xdg/xfce4/xfconf/xfce-perchannel-xml" \
  "/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml"; do
  mkdir -p "$config_dir"
  cat > "$config_dir/xfce4-desktop.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="image-path" type="string" value="$RIVET_WALLPAPER"/>
        <property name="last-image" type="string" value="$RIVET_WALLPAPER"/>
        <property name="image-show" type="bool" value="true"/>
        <property name="image-style" type="int" value="5"/>
      </property>
    </property>
  </property>
</channel>
EOF
done

# Use the GTK greeter explicitly and give the login screen its own wallpaper.
mkdir -p /etc/lightdm/lightdm.conf.d /etc/lightdm
cat > /etc/lightdm/lightdm.conf.d/10-rivet.conf <<'EOF'
[Seat:*]
greeter-session=lightdm-gtk-greeter
EOF

cat > /etc/lightdm/lightdm-gtk-greeter.conf <<EOF
[greeter]
background=$RIVET_LOGIN_WALLPAPER
EOF

# Keep Debian's tested Calamares module sequence, changing only its branding component.
mkdir -p /etc/calamares/branding/rivet
cat > /etc/calamares/branding/rivet/branding.desc <<'EOF'
---
componentName: rivet
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 900px,600px
windowPlacement: center

strings:
    productName: Rivet Linux
    shortProductName: Rivet
    version: Development
    shortVersion: Dev
    versionedName: Rivet Linux Development
    shortVersionedName: Rivet Dev
    bootloaderEntryName: Rivet Linux

sidebar: widget
navigation: widget

images:
    productLogo: "rivet.logo.png"
    productIcon: "rivet.logo.png"
    productWelcome: "rivet.logo.png"
EOF

# Ensure the welcome application is executable in the live and installed systems.
if [ ! -s /usr/bin/rivet-welcome ]; then
  echo "ERROR: Rivet welcome application is missing." >&2
  exit 1
fi
chmod 0755 /usr/bin/rivet-welcome

echo "Rivet visual configuration and welcome experience installed."
