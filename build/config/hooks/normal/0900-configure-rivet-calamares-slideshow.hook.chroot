#!/bin/sh
set -eu

BRANDING_DIR="/etc/calamares/branding/rivet"
BRANDING_DESC="${BRANDING_DIR}/branding.desc"
SLIDESHOW="${BRANDING_DIR}/show.qml"
CALAMARES_SETTINGS="/etc/calamares/settings.conf"

# The wiki and branding descriptor are versioned source files.
for required_file in "$BRANDING_DESC" "$SLIDESHOW"; do
  if [ ! -s "$required_file" ]; then
    echo "ERROR: Rivet Calamares branding file is missing: $required_file" >&2
    exit 1
  fi
done

grep -Fxq 'componentName: rivet' "$BRANDING_DESC"
grep -Fxq 'slideshow: "show.qml"' "$BRANDING_DESC"
grep -Fxq 'slideshowAPI: 2' "$BRANDING_DESC"
grep -Fq 'title: qsTr("Rivet Wiki")' "$SLIDESHOW"
grep -Fq 'text: "RIVET WIKI"' "$SLIDESHOW"
grep -Fq 'text: "WHERE IT STARTED"' "$SLIDESHOW"
grep -Fq 'text: "WHAT WE LEARNED"' "$SLIDESHOW"
grep -Fq 'text: "WHAT COMES NEXT"' "$SLIDESHOW"
if grep -Eq 'RIVET PONG|rivetPongField|gameTimer|targetScore' "$SLIDESHOW"; then
  echo "ERROR: the old Rivet Pong game remains in the Calamares slideshow." >&2
  exit 1
fi

# Calamares must not configure a splash program that Rivet no longer ships.
if [ ! -s "$CALAMARES_SETTINGS" ]; then
  echo "ERROR: Calamares settings file is missing: $CALAMARES_SETTINGS" >&2
  exit 1
fi
module_count="$(grep -Ec '^[[:space:]]*-[[:space:]]+plymouthcfg([[:space:]]|$)' "$CALAMARES_SETTINGS" || true)"
if [ "$module_count" -gt 1 ]; then
  echo "ERROR: found multiple plymouthcfg stages in Calamares settings." >&2
  exit 1
fi
if [ "$module_count" -eq 1 ]; then
  sed -i -E '/^[[:space:]]*-[[:space:]]+plymouthcfg([[:space:]]|$)/d' "$CALAMARES_SETTINGS"
fi
if grep -Eq '^[[:space:]]*-[[:space:]]+plymouthcfg([[:space:]]|$)' "$CALAMARES_SETTINGS"; then
  echo "ERROR: could not remove the obsolete plymouthcfg installation stage." >&2
  exit 1
fi

INSTALLER_CHECKER="/usr/lib/rivet/check-installer-pipeline.py"
if [ ! -s "$INSTALLER_CHECKER" ]; then
  echo "ERROR: Rivet installer pipeline checker is missing: $INSTALLER_CHECKER" >&2
  exit 1
fi
python3 "$INSTALLER_CHECKER" --root /
