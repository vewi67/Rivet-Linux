#!/bin/sh
set -eu

BRANDING_DIR="/etc/calamares/branding/rivet"
BRANDING_DESC="${BRANDING_DIR}/branding.desc"
SLIDESHOW="${BRANDING_DIR}/show.qml"

# The branding descriptor and slideshow are supplied as static, versioned files.
# Validate both the Calamares API settings and the built-in Rivet Pong game.
if [ ! -s "$BRANDING_DESC" ]; then
  echo "ERROR: Rivet Calamares branding descriptor is missing: $BRANDING_DESC" >&2
  exit 1
fi
if [ ! -s "$SLIDESHOW" ]; then
  echo "ERROR: Rivet Calamares slideshow is missing: $SLIDESHOW" >&2
  exit 1
fi

grep -Fxq 'componentName: rivet' "$BRANDING_DESC"
grep -Fxq 'slideshow: "show.qml"' "$BRANDING_DESC"
grep -Fxq 'slideshowAPI: 2' "$BRANDING_DESC"
grep -Fq 'Presentation {' "$SLIDESHOW"
grep -Fq 'title: qsTr("Instalando o Rivet Linux")' "$SLIDESHOW"
grep -Fq 'id: rivetPongField' "$SLIDESHOW"
grep -Fq 'mouseNavigation: false' "$SLIDESHOW"
grep -Fq 'function advanceGame()' "$SLIDESHOW"
grep -Fq 'property int targetScore: 5' "$SLIDESHOW"
grep -Fq 'id: gameTimer' "$SLIDESHOW"

# Refuse to produce an image with a branded but non-functional installer.
# This checks the real Debian-provided sequence and its live-image/GRUB settings.
INSTALLER_CHECKER="/usr/lib/rivet/check-installer-pipeline.py"
if [ ! -s "$INSTALLER_CHECKER" ]; then
  echo "ERROR: Rivet installer pipeline checker is missing: $INSTALLER_CHECKER" >&2
  exit 1
fi
python3 "$INSTALLER_CHECKER" --root /
